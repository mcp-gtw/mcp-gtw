# Copy to .env and override any GATEWAY_* setting. See docs/configuration.md.
# List values are comma separated.

# GATEWAY_APP_NAME=MCP Gateway
# GATEWAY_APP_VERSION is derived from the installed package version.
# Expose the version on the HTTP surface (/admin stats and /openapi.json). Off by default to avoid
# version fingerprinting. The authenticated MCP serverInfo always reports it (protocol requirement).
# GATEWAY_EXPOSE_VERSION=false

# Bind address for the bundled runner (python -m mcpgtw.main).
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8000

# Origins allowed to open the private provider WebSocket.
GATEWAY_ALLOWED_PROVIDER_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Origins allowed on /mcp. Empty accepts native clients that send no Origin.
GATEWAY_ALLOWED_MCP_ORIGINS=
# Origins allowed by CORS on the HTTP endpoints.
GATEWAY_CORS_ALLOW_ORIGINS=*

# Capacity limits below accept an empty value to mean unlimited (the default stays safe).
# GATEWAY_TOOL_CALL_TIMEOUT_SECONDS=60
# GATEWAY_MAXIMUM_TOOLS=128
# GATEWAY_MAXIMUM_TOOL_DEFINITION_BYTES=65536
# GATEWAY_MAXIMUM_PENDING_CALLS_PER_CHANNEL=64
# GATEWAY_MAXIMUM_MCP_SESSIONS_PER_CHANNEL=16
# GATEWAY_MAXIMUM_SUBSCRIPTIONS_PER_CHANNEL=1024
# GATEWAY_MAXIMUM_CHANNELS=10000
# Cap simultaneous connections at the server. Empty means no app-level cap.
# GATEWAY_MAXIMUM_CONCURRENT_CONNECTIONS=

# Always enforced (protect the process), cannot be disabled.
# GATEWAY_MAXIMUM_WEBSOCKET_MESSAGE_BYTES=524288
# GATEWAY_MAXIMUM_JSON_DEPTH=100

# GATEWAY_OFFLINE_TTL_SECONDS=300
# GATEWAY_REAPER_INTERVAL_SECONDS=30

# GATEWAY_MCP_JSON_RESPONSE=false
# GATEWAY_MCP_STATELESS=false
# GATEWAY_MCP_SESSION_IDLE_TIMEOUT_SECONDS=900

# GATEWAY_ADMIN_ENABLED=false
# GATEWAY_ADMIN_KEY=
# Path the admin dashboard is served at. Change it to make the admin surface harder to find.
# GATEWAY_ADMIN_PATH=/admin

 # OAuth is off by default. See docs/oauth.md.
# GATEWAY_OAUTH_MODE=off
# GATEWAY_OAUTH_RESOURCE_URL=
# GATEWAY_OAUTH_AUTHORIZATION_SERVERS=
# GATEWAY_OAUTH_REQUIRED_SCOPES=mcp:access
# GATEWAY_OAUTH_SUPPORTED_SCOPES=
# GATEWAY_OAUTH_ALLOW_STATIC_MCP_TOKENS=false
# GATEWAY_OAUTH_ALLOW_LOCALHOST_HTTP=false
# GATEWAY_OAUTH_TOKEN_VERIFIER=jwt
# GATEWAY_OAUTH_JWKS_URL=
# GATEWAY_OAUTH_JWT_ALLOWED_ALGORITHMS=RS256,ES256
# GATEWAY_OAUTH_INTROSPECTION_URL=
# GATEWAY_OAUTH_INTROSPECTION_CLIENT_ID=
# GATEWAY_OAUTH_INTROSPECTION_CLIENT_SECRET=
# GATEWAY_OAUTH_HTTP_TIMEOUT_SECONDS=5.0
# GATEWAY_OAUTH_MAX_TOKEN_BYTES=8192
# GATEWAY_OAUTH_MAX_METADATA_BYTES=65536
# GATEWAY_OAUTH_JWKS_CACHE_TTL_SECONDS=300.0
# GATEWAY_OAUTH_CLOCK_SKEW_SECONDS=30
# GATEWAY_OAUTH_RATE_LIMIT_REQUESTS=120
# GATEWAY_OAUTH_RATE_LIMIT_WINDOW_SECONDS=1.0
# GATEWAY_OAUTH_RATE_LIMIT_MAXIMUM_KEYS=10000
# GATEWAY_OAUTH_MAXIMUM_SESSIONS=10000

# Embedded AS still requires application-injected identity, consent and durable storage.
# GATEWAY_OAUTH_EMBEDDED_ISSUER=
# GATEWAY_OAUTH_EMBEDDED_CIMD_ENABLED=true
# GATEWAY_OAUTH_EMBEDDED_CIMD_ALLOWED_ORIGINS=
# GATEWAY_OAUTH_EMBEDDED_DCR_ENABLED=false
# GATEWAY_OAUTH_EMBEDDED_AUTHORIZATION_TTL_SECONDS=600
# GATEWAY_OAUTH_EMBEDDED_AUTH_CODE_TTL_SECONDS=120
# GATEWAY_OAUTH_EMBEDDED_ACCESS_TOKEN_TTL_SECONDS=900
# GATEWAY_OAUTH_EMBEDDED_REFRESH_TOKEN_TTL_SECONDS=2592000

# Progressive backoff for public OAuth request budgets.
# GATEWAY_OAUTH_RATE_LIMIT_BACKOFF_SECONDS=1
# GATEWAY_OAUTH_RATE_LIMIT_MAXIMUM_BACKOFF_SECONDS=30
# GATEWAY_OAUTH_EMBEDDED_RATE_LIMIT_WINDOW_SECONDS=60
# GATEWAY_OAUTH_EMBEDDED_BROWSER_REQUESTS=30
# GATEWAY_OAUTH_EMBEDDED_TOKEN_REQUESTS=120
# GATEWAY_OAUTH_EMBEDDED_REGISTRATION_REQUESTS=10
# GATEWAY_OAUTH_EMBEDDED_METADATA_REQUESTS=120
# GATEWAY_OAUTH_EMBEDDED_CIMD_REQUESTS=10
# GATEWAY_OAUTH_EMBEDDED_CLIENT_REQUESTS=120
# GATEWAY_OAUTH_EMBEDDED_PRINCIPAL_REQUESTS=120
# GATEWAY_OAUTH_EMBEDDED_LOGIN_ATTEMPTS=10
